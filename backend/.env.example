# --- Mode d'execution ---
# Priorite : TESTING > DEVEL > PRODUCTION. Si les trois sont False -> DATABASE_URL.
#   TESTING_MODE=True     -> DATABASE_URL_TEST (SQLite, leger, pour testeurs)
#   DEVEL_MODE=True       -> DATABASE_URL_DEV (Postgres local, dev avec seed)
#   PRODUCTION_MODE=True  -> DATABASE_URL (production / Supabase)
# Un seul mode actif a la fois : le premier vrai dans l'ordre de priorite gagne.
TESTING_MODE=True
DEVEL_MODE=False
PRODUCTION_MODE=False

# --- Debug ---
# Affiche les requetes SQL de SQLAlchemy dans les logs (defaut: False)
DEBUG=False

# --- Bases de donnees ---
# Production
DATABASE_URL=postgresql+psycopg2://user:password@hote:5432/nom_de_la_base
# Developpement (Postgres local)
DATABASE_URL_DEV=postgresql+psycopg2://user:password@localhost:5432/nom_de_la_base_dev
# Test (SQLite, sans installation)
DATABASE_URL_TEST=sqlite:///./test.db

# --- Securite ---
# Cle secrete pour signer les tokens JWT (generer une cle aleatoire)
SECRET_KEY=remplacer-par-une-cle-secrete-aleatoire
# Duree de validite des tokens d'acces en minutes (defaut: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# ALGORITHM est volontairement non configurable (HS256), voir COMMENTS.md

# --- Stockage documents (Cloudflare R2, API S3-compatible) ---
# Les documents sont stockes dans R2 via l'API S3. Le backend proxy les
# fichiers (upload/download), R2 n'est jamais expose au navigateur.
# 1. Cree un bucket R2 dans le dashboard Cloudflare
# 2. Cree un token API (R2 -> Manage R2 API Tokens) avec lecture/ecriture
#    sur ce bucket, recupere Access Key ID et Secret Access Key
# 3. Endpoint : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#    (l'Account ID est visible sur la page Overview de R2)
# La region est toujours "auto" pour R2 (ignoree par R2, requise par boto3).
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=remplacer-par-access-key-id
S3_SECRET_KEY=remplacer-par-secret-access-key
S3_BUCKET_NAME=remplacer-par-nom-du-bucket
S3_REGION=auto

# --- CORS ---
# Origines autorisees (format JSON). En dev : http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Donnees initiales ---
# Utilises par `python -m app.initial_data` (creation du super admin)
SUPER_USER_EMAIL=admin@exemple.com
SUPER_USER_PASSWORD=changer-moi
