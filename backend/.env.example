# Ce fichier est un modele OPTIONNEL : sans .env, l'app dmarre sur SQLite
# (DATABASE_URL par defaut) avec des identifiants de dev. Copie-le en .env
# uniquement pour brancher Postgres local ou les vrais credentials R2.

# --- Base de donnees (source unique de verite) ---
# Defaut si absent : sqlite:///./dev.db
# Exemple Postgres local :
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/hackaton_dev

# --- Environnement ---
# development (defaut) ou production. En production, le demarrage est refuse
# si DATABASE_URL est SQLite ou si SECRET_KEY garde sa valeur par defaut.
# ENVIRONMENT=production

# --- Securite ---
# Cle secrete pour signer les tokens JWT. Generer une cle aleatoire :
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=remplacer-par-une-cle-secrete-aleatoire

# --- Stockage documents (Cloudflare R2, API S3-compatible) ---
# Sans ces valeurs, l'upload/download de documents echouera (placeholders).
# 1. Cree un bucket R2 dans le dashboard Cloudflare
# 2. Cree un token API (R2 -> Manage R2 API Tokens) en lecture/ecriture
# 3. Endpoint : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=remplacer-par-access-key-id
# S3_SECRET_KEY=remplacer-par-secret-access-key
# S3_BUCKET_NAME=remplacer-par-nom-du-bucket
# S3_REGION=auto

# --- CORS ---
# Origines autorisees (format JSON). Defaut : ["*"]
# ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Divers ---
# Affiche les requetes SQL de SQLAlchemy dans les logs (defaut: False)
# DEBUG=False
# Duree de validite des tokens d'acces en minutes (defaut: 30)
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Donnees initiales ---
# Utilises pour creer le super admin au premier demarrage.
# Defauts de dev : admin@example.com / admin-changeme
# SUPER_USER_EMAIL=admin@example.com
# SUPER_USER_PASSWORD=admin-changeme
