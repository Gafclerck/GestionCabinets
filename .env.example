# Configuration de la stack Docker (docker compose lit ce fichier depuis
# la racine). Copier en ".env" puis adapter les valeurs :
#   cp .env.example .env

# --- Base de donnees (conteneur Postgres, volume persistant pgdata) ---
POSTGRES_USER=cabinet
POSTGRES_PASSWORD=cabinet-dev-password
POSTGRES_DB=cabinet

# --- Securite ---
# Cle de signature JWT. Generer une cle aleatoire :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacer-par-une-cle-secrete-aleatoire

# --- Super admin ---
# Cree automatiquement au demarrage du backend si absent.
SUPER_USER_EMAIL=admin@cabinet.com
SUPER_USER_PASSWORD=changer-moi

# --- Stockage documents (Cloudflare R2) ---
# Les placeholders ci-dessous permettent a la stack de demarrer sans compte
# R2 ; seule la fonction upload de documents echouera tant que de vraies
# valeurs ne sont pas fournies.
S3_ENDPOINT_URL=https://placeholder.r2.cloudflarestorage.com
S3_ACCESS_KEY=placeholder
S3_SECRET_KEY=placeholder
S3_BUCKET_NAME=placeholder
